{
	"name": "Ubuntu",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"runArgs": [
		"--memory=10g",
		"--memory-swap=10g"
	],
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	// Store ALL Claude Code config (incl. the global .claude.json) inside the
	// mounted .claude volume so settings/auth survive container rebuilds.
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/go:1": {},
		"ghcr.io/devcontainers/features/terraform:1": {},
		"ghcr.io/devcontainers/features/node:": {
			"version": "24"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"hashicorp.terraform",
				"hashicorp.hcl"
			]
		}
	},
	"postCreateCommand": {
		"claude": "sudo chown -R vscode:vscode /home/vscode/.claude && curl -fsSL https://claude.ai/install.sh | bash",
		"disable-ipv6": "sudo cp /etc/hosts /tmp/hosts.tmp && sudo sed '/^::1\\s/d' /tmp/hosts.tmp | sudo tee /etc/hosts > /dev/null"
	},
	"mounts": [
		"source=claude-config-${localWorkspaceFolderBasename},target=/home/vscode/.claude,type=volume"
	]
}